# このファイルを .streamlit/secrets.toml にコピーして、実際の値を設定してください。
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# .streamlit/secrets.toml は .gitignore に含まれており、Gitにはコミットされません。
# 実際の認証情報は絶対にリポジトリにコミットしないでください。

# --- 第8章: Text-to-SQL / 第9章: Text-to-Python ---
# 注意: トップレベルのキーは [connections.xxx] などのテーブルより前に書くこと。
# （TOMLでは [table] の後に書いた bare key はそのテーブルの中の値として解釈されてしまうため）

# Anthropic APIキー（https://console.anthropic.com/ で取得）
# ANTHROPIC_API_KEY = "sk-ant-..."

# E2B APIキー（https://e2b.dev/ で取得）
# E2B_API_KEY = "e2b_..."

# --- 第4章: データベース接続 ---

# SQLite（ローカルファイル。最も手軽な接続先）
[connections.local_db]
url = "sqlite:///data/analytics.db"

# PostgreSQL（利用する場合はコメントを外して設定）
# [connections.postgresql]
# dialect = "postgresql"
# host = "localhost"
# port = 5432
# database = "analytics"
# username = "bi_user"
# password = "your-password"

# BigQuery（利用する場合はサービスアカウントキーのJSONの内容を設定）
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "..."
# private_key = "..."
# client_email = "..."
